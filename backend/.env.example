# Copy to backend/.env (ignored by Git). Leaving DATABASE_URL unset uses memory locally.
# For Supabase, copy the Connect > Session pooler URL and replace its password placeholder.
# Keep the actual URL and password only in backend/.env or your API host's secret settings.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# If your database uses a custom certificate authority, download its certificate from
# Supabase Database settings and set this local path. Server identity is always verified.
# DATABASE_CA_FILE=C:/path/to/supabase-ca.crt
